{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/marketing/**",
              "components/navigation/**",
              "ui_kits/analytics_app/**",
              "ui_kits/polecat_live/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdvantageBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|lead|pills|foot|style|key|ref|className|style|children)$/]",
        "message": "<AdvantageBand> doesn't accept that prop. Declared props: kicker, lead, pills, foot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:app|glyph|name|host|tagline|version|shipped|status|fun|hover|style|key|ref|className|style|children)$/]",
        "message": "<AppCard> doesn't accept that prop. Declared props: app, glyph, name, host, tagline, version, shipped, status, fun, hover, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:live|soon)$/]",
        "message": "<AppCard> status must be one of 'live' | 'soon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuroraBackdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:grain|style|key|ref|className|style|children)$/]",
        "message": "<AuroraBackdrop> doesn't accept that prop. Declared props: grain, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|surface|icon|iconRight|disabled|block|href|as|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, surface, icon, iconRight, disabled, block, href, as, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:site|app)$/]",
        "message": "<Button> surface must be one of 'site' | 'app'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a|span)$/]",
        "message": "<Button> as must be one of 'button' | 'a' | 'span'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|feature|fix|polish|warn)$/]",
        "message": "<Chip> tone must be one of 'neutral' | 'feature' | 'fix' | 'polish' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|actions|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, description, actions, style."
